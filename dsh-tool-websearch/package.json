{
  "name": "dsh-tool-websearch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 多引擎元搜索插件：Host 工具、浏览器结果卡与代理开关统一由一个 Cordis 包提供",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib"
  ],
  "dependencies": {},
  "scripts": {
    "build": "bun build src/runner.ts --target=node --format=esm --outfile=lib/search.bundle.mjs",
    "test": "node --experimental-test-module-mocks --test test/*.test.mjs"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.74",
    "htmlparser2": "8.0.2",
    "undici": "^6.21.2"
  }
}
