{
  "name": "dsh-tool-websearch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH web_search 工具:封装 s-code 的多引擎元搜索模块(纯 Node 运行时,构建期依赖 bun/esbuild)",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dependencies": {},
  "scripts": {
    "build": "bun build src/runner.ts --target=node --format=esm --outfile=lib/search.bundle.mjs"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.74",
    "htmlparser2": "8.0.2"
  }
}
